# 환경 변수 설정 파일 (.env로 복사하여 사용하세요)
# 1. 서버 포트 번호
PORT=8080

# 2. 날씨 API 서비스 선택 ('open-meteo' 또는 'openweathermap')
# 'open-meteo'는 API Key 없이 즉시 사용 가능합니다.
WEATHER_PROVIDER=open-meteo

# 3. OpenWeatherMap을 사용할 경우 발급받은 API 키를 입력하세요.
# (Open-Meteo 사용 시 비워두셔도 됩니다)
OPENWEATHER_API_KEY=your_openweather_api_key_here
